                      "group": "loki",
                      "kind": "DataQuery",
                      "spec": {
                        "direction": "backward",
                        "editorMode": "code",
                        "expr": "sum(count_over_time({service_namespace=\"team-esyfo\", k8s_cluster_name=~\"prod|prod-fss\", service_name=~\"${app:regex}\"} | k8s_container_name !~ `secure-logs-fluentbit|cloudsql-proxy|wonderwall|elector` | detected_level=~`(?i)(error|critical|fatal)` [$__range])) or on() vector(0)",
