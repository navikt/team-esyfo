{
	"name": "team-esyfo-docs",
	"private": true,
	"packageManager": "pnpm@11.3.0",
	"type": "module",
	"scripts": {
		"dev": "vitepress dev",
		"build": "pnpm typecheck && pnpm runtime-error-contract:check && pnpm runtime-error-contract:test && pnpm inventory:check && pnpm inventory:test && pnpm alert-register:check && pnpm alert-register:test && pnpm grafana-dashboard:test && pnpm error-dashboard:check && pnpm control-room:check && vitepress build && pnpm inventory:export",
		"typecheck": "vue-tsc --noEmit",
		"runtime-error-contract:check": "node scripts/runtime-error-contract.ts check",
		"runtime-error-contract:test": "node --test .vitepress/observability/runtime-error-contract.test.ts",
		"runtime-error-contract:export": "node scripts/runtime-error-contract.ts export",
		"inventory:check": "node scripts/runtime-inventory.ts check",
		"inventory:test": "node --test .vitepress/runtime/*.test.ts",
		"inventory:export": "node scripts/runtime-inventory.ts export",
		"inventory:drift": "node scripts/runtime-inventory.ts drift",
		"inventory:coverage": "node scripts/runtime-inventory.ts coverage",
		"inventory:observe": "node scripts/observe-nais.ts",
		"alert-register:check": "node scripts/alert-registry.ts check",
		"alert-register:test": "node --test .vitepress/alerts/*.test.ts",
		"alert-register:export": "node scripts/alert-registry.ts export",
		"alert-register:drift": "node scripts/alert-registry.ts drift",
		"grafana-dashboard:test": "node --test .vitepress/grafana/*.test.ts",
		"error-dashboard:test": "node --test .vitepress/grafana/error-drilldown.test.ts",
		"error-dashboard:check": "node scripts/error-drilldown.ts check",
		"error-dashboard:export": "node scripts/error-drilldown.ts export",
		"control-room:test": "node --test .vitepress/grafana/control-room.test.ts",
		"control-room:check": "node scripts/control-room.ts check",
		"control-room:export": "node scripts/control-room.ts export",
		"grafana-dashboard:smoke": "node scripts/grafana-dashboard-smoke.ts",
		"preview": "vitepress preview"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.14",
		"@braintree/sanitize-url": "^7.1.2",
		"@types/node": "^24.10.0",
		"ajv": "^8.20.0",
		"cytoscape": "^3.33.3",
		"cytoscape-cose-bilkent": "^4.1.0",
		"dayjs": "^1.11.20",
		"debug": "^4.4.3",
		"mermaid": "^11.14.0",
		"typescript": "^5.9.3",
		"vite": "^8.0.10",
		"vitepress": "^1.6.4",
		"vitepress-plugin-mermaid": "^2.0.17",
		"vue": "^3.5.33",
		"vue-tsc": "^3.0.8"
	}
}
